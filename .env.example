# ═════ docker compose uchun asosiy sozlamalar (production) ═════
# Barcha "change-me" qiymatlarni almashtiring!
POSTGRES_DB=agromarket
POSTGRES_USER=agromarket
POSTGRES_PASSWORD=change-me-strong-db-password
WEB_PORT=8080

APP_URL=https://agromarket.uz
API_PUBLIC_URL=https://agromarket.uz
COOKIE_SECURE=true
COOKIE_DOMAIN=

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
OTP_SECRET=change-me

# Birinchi ishga tushishda admin avtomatik yaratiladi (parol kamida 10 belgi)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true — baza bo'sh bo'lsa demo ma'lumotlar yuklanadi (taqdimot uchun)
SEED_DEMO=false
# true — kurs ishi taqdimoti: sandbox to'lov va SMS kodi ekranda. REAL BIZNESDA false!
DEMO_MODE=false

# local | db (fayllar PostgreSQL'da) | s3 (S3 / Supabase Storage)
STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=agromarket
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://cdn.agromarket.uz
# S3_PRIVATE_BUCKET=agromarket-private

# Productionda sandbox to'lov o'chiq (DEMO_MODE=true bo'lmasa)
PAYMENT_SANDBOX=false
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CARD_PROVIDER=click
UNPAID_ORDER_TTL_MIN=30
# Bitta IP uchun daqiqasiga so'rovlar limiti (API)
RATE_LIMIT_PER_MIN=600

SMS_DRIVER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# console | smtp | gmail_https
#  smtp + Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=siz@gmail.com SMTP_PASS=<16 belgili App Password>
#  gmail_https : Render FREE uchun (SMTP portlari bloklangan) — docs/gmail-apps-script.gs
EMAIL_DRIVER=smtp
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AgroMarket <no-reply@agromarket.uz>"
