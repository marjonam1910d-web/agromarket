# ───────── Asosiy ─────────
NODE_ENV=development
PORT=4000
# Frontend manzili (CORS va to'lovdan qaytish uchun)
APP_URL=http://localhost:5173
# API'ning tashqi manzili (fayl URL'lari uchun)
API_PUBLIC_URL=http://localhost:4000
TZ=Asia/Tashkent

# ───────── Ma'lumotlar bazasi ─────────
DATABASE_URL=postgresql://agromarket:agromarket@localhost:5432/agromarket?schema=public

# ───────── Redis (ixtiyoriy: kesh, rate limit, realtime pub/sub) ─────────
# Bo'sh qoldirilsa — xotiradagi (in-memory) fallback ishlaydi (bitta server uchun yetarli)
REDIS_URL=

# ───────── Xavfsizlik ─────────
# Kamida 32 belgili tasodifiy qatorlar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
OTP_SECRET=change-me-otp-secret-at-least-32-characters-long-xx
# HTTPS orqali ishlaganda true
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Faqat development: OTP kodini API javobida qaytarish (productionda avtomatik o'chadi)
OTP_DEV_ECHO=true

# ───────── Fayllar ─────────
# local | s3
# local | db (fayllar PostgreSQL'da) | s3 (S3 / Supabase Storage)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_PRIVATE_BUCKET=

# ───────── To'lovlar ─────────
# Haqiqiy kalitlar bo'lmasa sandbox (test) provayder ishlatiladi
PAYMENT_SANDBOX=true
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Uzcard/Humo kartalari qaysi provayder orqali: payme | click
CARD_PROVIDER=click
# To'lanmagan onlayn buyurtma necha daqiqadan keyin bekor qilinadi
UNPAID_ORDER_TTL_MIN=30
# Bitta IP uchun daqiqasiga so'rovlar limiti (API)
RATE_LIMIT_PER_MIN=600

# ───────── SMS (Eskiz.uz) ─────────
# console | eskiz
SMS_DRIVER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ───────── Email (SMTP) ─────────
# console | smtp
# console | smtp | gmail_https
#  smtp + Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=siz@gmail.com SMTP_PASS=<16 belgili App Password>
#  gmail_https : Render FREE uchun (SMTP portlari bloklangan) — docs/gmail-apps-script.gs
EMAIL_DRIVER=console
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AgroMarket <no-reply@agromarket.uz>"

# Production / Render (docs/DEPLOY_RENDER_SUPABASE.md)
# FRONTEND_DIR=../frontend/dist   # backend frontendni ham o'zi beradi (bitta servis)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# SEED_DEMO=false
# DEMO_MODE=false                  # REAL BIZNESDA false!
