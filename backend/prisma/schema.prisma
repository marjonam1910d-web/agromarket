// AgroMarket — PostgreSQL schema (Prisma)
// Pul qiymatlari Decimal(14,2) — so'm. Miqdorlar Decimal(14,3) — kg/litr kasr bo'lishi mumkin.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
}

enum ProductStatus {
  draft
  pending_review
  active
  rejected
  inactive
  out_of_stock
}

enum Unit {
  kg
  g
  tonna
  dona
  litr
  qop
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready_for_delivery
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentMethod {
  cash
  payme
  click
  card
}

enum PaymentProvider {
  cash
  payme
  click
  sandbox
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  cancelled
  refunded
  partially_refunded
}

enum RefundStatus {
  requested
  approved
  processed
  rejected
}

enum DeliveryStatus {
  pending
  scheduled
  picked_up
  in_transit
  delivered
  failed
  cancelled
}

enum ReviewStatus {
  published
  hidden
}

enum ComplaintStatus {
  open
  in_review
  resolved
  rejected
}

enum CouponType {
  percent
  fixed
}

// ───────────────────────── Users & auth ─────────────────────────

model User {
  id               String     @id @default(cuid())
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String
  fullName         String
  role             Role       @default(BUYER)
  status           UserStatus @default(ACTIVE)
  locale           String     @default("uz")
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  termsAcceptedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  buyerProfile   BuyerProfile?
  sellerProfile  SellerProfile?
  sessions       Session[]
  addresses      Address[]
  cart           Cart?
  favorites      Favorite[]
  orders         Order[]
  reviews        Review[]
  notifications  Notification[]
  sentMessages   Message[]
  buyerConvs     Conversation[]      @relation("BuyerConversations")
  sellerConvs    Conversation[]      @relation("SellerConversations")
  complaints     Complaint[]         @relation("ComplaintReporter")
  complaintsAgainst Complaint[]      @relation("ComplaintAgainst")
  auditLogs      AuditLog[]
  reviewReports  ReviewReport[]
  couponUses     CouponRedemption[]

  @@index([role, status])
  @@index([createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         String     @id @default(cuid())
  target     String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([target, purpose, createdAt])
}

model BuyerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  isWholesale Boolean  @default(false)
  companyName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  farmName           String
  slug               String             @unique
  description        String?
  region             String
  district           String
  address            String
  tin                String?
  logoUrl            String?
  coverUrl           String?
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  verifiedAt         DateTime?
  ratingAvg          Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  products      Product[]
  verifications SellerVerification[]
  sellerOrders  SellerOrder[]
  deliveryZones DeliveryZone[]
  promotions    Promotion[]
  coupons       Coupon[]
  reviews       Review[]

  @@index([verificationStatus])
  @@index([region, district])
}

model SellerVerification {
  id           String             @id @default(cuid())
  sellerId     String
  documentType String
  documentPath String // xususiy fayl — faqat egasi va admin ko'radi
  status       VerificationStatus @default(PENDING)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Address {
  id            String    @id @default(cuid())
  userId        String
  label         String    @default("Uy")
  recipientName String
  phone         String
  region        String
  district      String
  street        String
  landmark      String?
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameUz    String
  nameRu    String
  nameEn    String
  icon      String?
  imageUrl  String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id              String        @id @default(cuid())
  sellerId        String
  categoryId      String
  name            String
  slug            String        @unique
  description     String
  price           Decimal       @db.Decimal(14, 2)
  discountPrice   Decimal?      @db.Decimal(14, 2)
  // = discountPrice ?? price. Saralash/filtrlash uchun denormalizatsiya (servis qatlamida yangilanadi)
  effectivePrice  Decimal       @db.Decimal(14, 2)
  unit            Unit
  minOrderQty     Decimal       @default(1) @db.Decimal(14, 3)
  weightPerUnitKg Decimal       @default(1) @db.Decimal(10, 3)
  region          String
  district        String
  isSeasonal      Boolean       @default(false)
  seasonLabel     String?
  isOrganic       Boolean       @default(false)
  status          ProductStatus @default(draft)
  rejectionReason String?
  ratingAvg       Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount     Int           @default(0)
  soldCount       Decimal       @default(0) @db.Decimal(14, 3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  seller     SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  inventory  ProductInventory?
  cartItems  CartItem[]
  favorites  Favorite[]
  orderItems OrderItem[]
  reviews    Review[]
  promotions Promotion[]

  @@index([status, deletedAt])
  @@index([categoryId])
  @@index([sellerId])
  @@index([region, district])
  @@index([effectivePrice])
  @@index([ratingAvg])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  thumbUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductInventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  quantity          Decimal  @default(0) @db.Decimal(14, 3)
  lowStockThreshold Decimal  @default(10) @db.Decimal(14, 3)
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Promotion {
  id              String   @id @default(cuid())
  sellerId        String?
  title           String
  description     String?
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller   SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([isActive, startsAt, endsAt])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  sellerId       String? // null => platforma kuponi
  type           CouponType
  value          Decimal    @db.Decimal(14, 2)
  minOrderAmount Decimal    @default(0) @db.Decimal(14, 2)
  maxDiscount    Decimal?   @db.Decimal(14, 2)
  usageLimit     Int?
  usedCount      Int        @default(0)
  perUserLimit   Int        @default(1)
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())

  seller      SellerProfile?     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]
  orders      Order[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

// ───────────────────────── Cart & favorites ─────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String     @unique
  couponCode String?
  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Decimal  @db.Decimal(14, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ───────────────────────── Orders ─────────────────────────

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  buyerId          String
  status           OrderStatus   @default(pending)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(pending)
  subtotal         Decimal       @db.Decimal(14, 2)
  deliveryFee      Decimal       @db.Decimal(14, 2)
  discountTotal    Decimal       @default(0) @db.Decimal(14, 2)
  total            Decimal       @db.Decimal(14, 2)
  couponId         String?
  recipientName    String
  contactPhone     String
  region           String
  district         String
  addressLine      String
  deliveryDate     DateTime      @db.Date
  deliverySlot     String
  deliveryNotes    String?
  idempotencyKey   String?       @unique
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  buyer         User                 @relation(fields: [buyerId], references: [id])
  coupon        Coupon?              @relation(fields: [couponId], references: [id])
  sellerOrders  SellerOrder[]
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  complaints    Complaint[]

  @@index([buyerId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model SellerOrder {
  id               String      @id @default(cuid())
  orderId          String
  sellerId         String
  number           String      @unique
  status           OrderStatus @default(pending)
  subtotal         Decimal     @db.Decimal(14, 2)
  deliveryFee      Decimal     @db.Decimal(14, 2)
  discount         Decimal     @default(0) @db.Decimal(14, 2)
  total            Decimal     @db.Decimal(14, 2)
  commissionRate   Decimal     @db.Decimal(5, 2)
  commissionAmount Decimal     @db.Decimal(14, 2)
  sellerPayout     Decimal     @db.Decimal(14, 2)
  rejectionReason  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller        SellerProfile        @relation(fields: [sellerId], references: [id])
  items         OrderItem[]
  delivery      Delivery?
  statusHistory OrderStatusHistory[]
  refunds       Refund[]

  @@index([sellerId, status])
  @@index([orderId])
  @@index([createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  sellerOrderId String
  productId     String
  productName   String
  imageUrl      String?
  unit          Unit
  unitPrice     Decimal  @db.Decimal(14, 2)
  quantity      Decimal  @db.Decimal(14, 3)
  lineTotal     Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  review      Review?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id            String       @id @default(cuid())
  orderId       String
  sellerOrderId String?
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  note          String?
  actorId       String?
  createdAt     DateTime     @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ───────────────────────── Payments ─────────────────────────

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  method            PaymentMethod
  amount            Decimal         @db.Decimal(14, 2)
  currency          String          @default("UZS")
  status            PaymentStatus   @default(pending)
  refundedAmount    Decimal         @default(0) @db.Decimal(14, 2)
  providerPaymentId String?
  checkoutUrl       String?
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([orderId])
  @@index([status, createdAt])
}

// Provayder tomonidagi tranzaksiya (Payme/Click/Sandbox). Idempotentlik: (provider, providerTxId) unikal.
model PaymentTransaction {
  id           String          @id @default(cuid())
  paymentId    String
  provider     PaymentProvider
  providerTxId String
  state        Int             @default(1) // Payme semantikasi: 1 yaratildi, 2 bajarildi, -1/-2 bekor
  amount       Decimal         @db.Decimal(14, 2)
  createTime   BigInt
  performTime  BigInt          @default(0)
  cancelTime   BigInt          @default(0)
  reason       Int?
  rawPayload   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxId])
  @@index([paymentId])
  @@index([createTime])
}

model Refund {
  id            String       @id @default(cuid())
  paymentId     String
  sellerOrderId String?
  amount        Decimal      @db.Decimal(14, 2)
  reason        String
  status        RefundStatus @default(requested)
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id])

  @@index([status])
}

// ───────────────────────── Delivery ─────────────────────────

model DeliveryZone {
  id             String   @id @default(cuid())
  sellerId       String
  region         String
  district       String? // null => viloyatning barcha tumanlari
  baseFee        Decimal  @db.Decimal(14, 2)
  perKgFee       Decimal  @default(0) @db.Decimal(14, 2)
  freeFromAmount Decimal? @db.Decimal(14, 2)
  minDays        Int      @default(1)
  maxDays        Int      @default(3)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, region])
}

model Delivery {
  id            String         @id @default(cuid())
  sellerOrderId String         @unique
  status        DeliveryStatus @default(pending)
  fee           Decimal        @db.Decimal(14, 2)
  weightKg      Decimal        @db.Decimal(12, 3)
  courierName   String?
  courierPhone  String?
  trackingNote  String?
  scheduledDate DateTime?      @db.Date
  slot          String?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sellerOrder SellerOrder             @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  history     DeliveryStatusHistory[]
}

model DeliveryStatusHistory {
  id         String         @id @default(cuid())
  deliveryId String
  status     DeliveryStatus
  note       String?
  actorId    String?
  createdAt  DateTime       @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
}

// ───────────────────────── Reviews ─────────────────────────

model Review {
  id           String       @id @default(cuid())
  orderItemId  String       @unique // bitta xarid qatoriga bitta sharh
  productId    String
  sellerId     String
  buyerId      String
  rating       Int
  sellerRating Int?
  text         String?
  images       String[]     @default([])
  status       ReviewStatus @default(published)
  reportCount  Int          @default(0)
  sellerReply  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller    SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyer     User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  reports   ReviewReport[]

  @@index([productId, status])
  @@index([sellerId])
}

model ReviewReport {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  reason    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

// ───────────────────────── Notifications & chat ─────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Conversation {
  id            String   @id @default(cuid())
  buyerId       String
  sellerUserId  String
  productId     String?
  orderId       String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerUserId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([buyerId, sellerUserId])
  @@index([sellerUserId, lastMessageAt])
  @@index([buyerId, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  productId      String?
  orderId        String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ───────────────────────── Moderation & admin ─────────────────────────

model Complaint {
  id           String          @id @default(cuid())
  reporterId   String
  againstId    String?
  orderId      String?
  productId    String?
  subject      String
  description  String
  status       ComplaintStatus @default(open)
  resolution   String?
  handledById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  reporter User   @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  against  User?  @relation("ComplaintAgainst", fields: [againstId], references: [id])
  order    Order? @relation(fields: [orderId], references: [id])

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Fayllarni bazaning o'zida saqlash (STORAGE_DRIVER=db) — alohida S3 kerak bo'lmagan kichik deploymentlar uchun
model StoredObject {
  key         String   @id
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}
